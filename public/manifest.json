{
  "manifest_version": 3,
  "name": "Repo Watcher",
  "version": "1.0.0",
  "description": "GitHub のイベントを検知し、ユーザーに通知を行う Chrome 拡張機能",
  "permissions": ["storage", "notifications", "alarms", "activeTab"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "src/options/index.html",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Repo Watcher"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
