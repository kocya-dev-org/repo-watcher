{
  "manifest_version": 3,
  "name": "Repo Watcher",
  "version": "1.0.0",
  "description": "A Chrome extension that monitors the status of GitHub pull requests and issues",
  "default_locale": "en",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "src/options/index.html",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Repo Watcher",
    "default_icon": "icon128.png"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
